"jy61p\stm32f1xx_hal.o"
"jy61p\stm32f1xx_hal_rcc.o"
"jy61p\stm32f1xx_hal_rcc_ex.o"
"jy61p\stm32f1xx_hal_gpio.o"
"jy61p\stm32f1xx_hal_dma.o"
"jy61p\stm32f1xx_hal_cortex.o"
"jy61p\stm32f1xx_hal_pwr.o"
